# tuned/repo.env -- pytorch-specific settings for tuned builds. Sourced by tuned/env.sh after
# the shared device and toolkit definitions (tuned/common-data, from zbrad/tuned-common).
# Tracked, so a release is reproducible.
#
# This file may only ADD repo-specific settings. Changing any shared key (GPU_TUNED_*, CUDA_*,
# TOOLKIT_*) is a loud error from env.sh. Plain assignment on purpose: this file is sourced
# inside a function, where `declare` would make the variable local and lose it.

# PyTorch spells the arch dotted ("12.1a", "8.9") in TORCH_CUDA_ARCH_LIST; the shared device
# files carry the resolved cuobjdump form ("121a", "89"). Insert the dot before the last digit.
GPU_TUNED_TORCH_ARCH="$(printf '%s' "${GPU_TUNED_CUDA_ARCH}" | sed -E 's/^([0-9]+)([0-9])(a?)$/\1.\2\3/')"

# GB10's Grace CPU (Cortex-X925/A725) has no SME/SME2 -- this is the whole reason
# CMakeLists.txt's USE_KLEIDIAI_SME option exists (added on this branch). rtx40/rtx50 do not need
# it: KleidiAI itself is already gated off entirely on x86_64
# (cmake_dependent_option(USE_KLEIDIAI ... "CPU_AARCH64" OFF)), so there is nothing to override.
case "${GPU_TUNED_VARIANT}" in
    gb10) GPU_TUNED_USE_KLEIDIAI_SME="0" ;;
    *)    GPU_TUNED_USE_KLEIDIAI_SME="" ;;
esac

# Which upstream ref the build-info stamp's base is computed against: upstream's default branch.
# The base recorded is the merge-base with it, i.e. what tuned-builds actually contains (not a
# tag we have not merged). Override per build with GPU_TUNED_UPSTREAM_REF in the environment.
GPU_TUNED_UPSTREAM_REF="${GPU_TUNED_UPSTREAM_REF:-upstream/main}"
