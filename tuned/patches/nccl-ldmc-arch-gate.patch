From 2f9a113b79aa52cabf3590722fd543bbba6c0edc Mon Sep 17 00:00:00 2001
From: Brad Merrill <brad_merrill@hotmail.com>
Date: Fri, 18 Sep 2026 00:48:33 -0700
Subject: [PATCH] device: gate LDMC/multicast FP8 kernel gencode on
 NVCC_GENCODE, not just CUDA version

Upstream gated NVCC_GENCODE_LDMC_FP8 (sm_100f/sm_100a datacenter-Blackwell
multicast device code) purely on CUDA toolkit version (>=12.7), so it got
unconditionally compiled into every build with CUDA >= 12.7 regardless of
the actual target GPU -- breaking single-arch tuned builds targeting e.g.
GB10 (sm_121a, no NVSwitch/multicast hardware, can never reach this code
at runtime) with a fat multi-arch binary. Now also requires NVCC_GENCODE
(correctly derived from TORCH_CUDA_ARCH_LIST by pytorch's own
cmake/External/nccl.cmake) to actually target compute_100, matching the
same pattern pytorch's own cmake/Codegen.cmake already uses for analogous
additional-arch gating (_BUILD_FOR_ADDITIONAL_ARCHS).

zbrad/pytorch tuned-builds fork-local fix. Not upstreamed (yet) -- this
nested checkout isn't a tracked git submodule of the outer pytorch repo
(third_party/nccl/ is gitignored there), so this commit is local-only;
see zbrad/pytorch's tuned-common project memory for the durability caveat
and what re-clones/resets this checkout.

Assisted-by: Claude
---
 src/device/Makefile | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/src/device/Makefile b/src/device/Makefile
index ccaec11..b82d996 100644
--- a/src/device/Makefile
+++ b/src/device/Makefile
@@ -39,6 +39,18 @@ define COMPILE
  $(call COMPILE$(or $3,$(suffix $2)),$1,$2)
 endef
 
+# zbrad/pytorch tuned-builds: gate LDMC/multicast FP8 kernel generation on
+# the actual target arch list (NVCC_GENCODE, correctly derived upstream
+# from TORCH_CUDA_ARCH_LIST), not just the CUDA toolkit version. Upstream's
+# CUDA-version-only gate unconditionally compiled sm_100f/sm_100a device
+# code into every build with CUDA >= 12.7, regardless of target GPU --
+# datacenter-Blackwell-exclusive multicast hardware that real-arch-list
+# single-arch tuned builds (e.g. GB10/sm_121a, no NVSwitch) can never
+# reach at runtime, but which broke gpu_tuned_verify_arch's single-arch
+# invariant on any CUDA toolkit >= 12.7 regardless of target. Matches the
+# same MATCHES-pattern PyTorch's own cmake/Codegen.cmake already uses for
+# analogous additional-arch gating (_BUILD_FOR_ADDITIONAL_ARCHS).
+ifneq ($(findstring compute_100,$(NVCC_GENCODE)),)
 ifeq ($(shell echo "$$((1000*$(CUDA_MAJOR) + 10*$(CUDA_MINOR) >= 12090))"),1)
 	NVCC_GENCODE_LDMC_FP8 = -gencode=arch=compute_100f,code=sm_100f
 else ifeq ($(shell echo "$$((1000*$(CUDA_MAJOR) + 10*$(CUDA_MINOR) >= 12070))"),1)
@@ -46,6 +58,9 @@ else ifeq ($(shell echo "$$((1000*$(CUDA_MAJOR) + 10*$(CUDA_MINOR) >= 12070))"),
 else
 	NVCC_GENCODE_LDMC_FP8 =
 endif
+else
+	NVCC_GENCODE_LDMC_FP8 =
+endif
 
 define COMPILE_SYM
 @$(SAY) "Compiling" $2;\
-- 
2.43.0

